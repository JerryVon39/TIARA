// 番组管家 · TIARA —— YAYA 版字典（basis.dic）
// 由 tools/build_yaya.mjs 从 data/talks.json 生成，别手改。
// 和里々版共用同一套台词；差别只在于 YAYA 能读文件、能比时间。


OnFirstBoot {
    "\0\s[1]初次见面。学生会副会长，馬剃天愛星。……以后，请多指教。\e"
    "\0\s[0]记录簿我收下了。以后 {nickname} 的观看进度，由我来登记。……有意见吗？\e"
}

OnBoot {
    "\0\s[0]学生会，开始办公。……{nickname}，今天的案件我确认过了。\\n周二没有要追的番。主人，要不要补一补积压的？\e"
    "\0\s[1]副会长，到任。……我回来了，{nickname}。\\n周二没有要追的番。主人，要不要补一补积压的？\e"
    "\0\s[0]……{nickname}。昨晚几点睡的，记录上可写着呢。\\n周二没有要追的番。主人，要不要补一补积压的？\e"
}

OnNadeNade {
    "\0\s[0]……手放在头上是什么意思。……解释一下。\e"
    "\0\s[0]……真是的。{nickname}，今天是第 {nade_today} 次了。\e"
    "\0\s[1]……随你便。反正，我也不会躲。\e"
    "\0\s[1]……那个。也不是……讨厌。\e"
    "\0\s[1]……今天，就特别允许你。{nade_total} 次了，记住。\e"
}

OnMouseWheel {
    "\0\s[3]……放大是要干什么。\e"
    "\0\s[0]看着舒服就好。……随你。\e"
}

OnMouseDoubleClick {
    "\0\s[3]……！突然抱过来……不行，太狡猾了。\e"
    "\0\s[3]……就、就一小会儿。别人看不见吧。\e"
    "\0\s[1]……{nickname} 的味道。……咳，没什么。\e"
}

OnClose {
    "\0\s[0]下班。……案件，别攒着。\e"
}

今日 {
    "\0\s[0]周二没有要追的番。主人，要不要补一补积压的？\e"
}

// 每 30 秒查一次：today.json 里有没有「刚刚开播」的番。
// yayaTick / yayaData / yayaAge / yayaDone 是全局变量，YAYA 退出时自己存档。

OnSecondChange {
    yayaTick = yayaTick + 1
    if yayaTick < 30 { return }
    yayaTick = 0
    yayaAge = yayaAge + 30
    if GETTYPE(yayaData) == 0 || yayaAge > 600 {
        yayaData = FREADJSON("today.json")
        yayaAge = 0
    }
    if GETTYPE(yayaData) != 5 { return }
    _list = yayaData["all_shows"]
    if GETTYPE(_list) != 4 { return }
    _t = GETTIME()
    _wd = _t[3]
    if _wd == 0 { _wd = 7 }          // GETTIME 是 0=周日，我们的表是 1=周一
    _now = _t[4] * 60 + _t[5]
    if GETTYPE(yayaDone) == 0 { yayaDone = "" }   // 首次运行时它还不存在
    foreach _list ; _s {
        if _s["weekday"] != _wd { continue }
        _d = _now - _s["min"]
        if _d < 0 || _d > 4 { continue }   // 只认刚过去的 5 分钟
        _key = "" + _s["id"] + "@" + yayaData["date"]
        if _key _in_ yayaDone { continue }
        yayaDone ,= _key
        "\0\s[1]%(_s[""name_cn""]) 开播了。别装没看见。\e"
    }
}
